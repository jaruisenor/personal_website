---
import { site, projects } from '../content/site';
import '../styles/global.css';

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="monogram" href="#about" aria-label="Joaquin Ruiseñor, introduction"><span aria-hidden="true">//</span> JR</a>
      <a href="#career">Experience <span aria-hidden="true">↓</span></a>
    </header>
    <div class="page">
      <main id="main">
        <section id="about" class="intro" aria-labelledby="intro-title">
          <div class="initials" aria-hidden="true">JR</div>
          <h1 id="intro-title">Hey, I’m <span>{site.name}</span>.</h1>
          <p>Chilean Product Manager at Google, based in London.</p>
          <p>AI pilled. Systems mindset. A background in analytics and data.</p>
          <p class="muted">Outside work: technology, sports and Brazilian Jiu-Jitsu.</p>
          <div class="links">{site.links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="sr-only">Opens in a new tab</span></a>)}</div>
        </section>
        <section id="stack" aria-labelledby="stack-title">
          <h2 id="stack-title">Tech stack</h2>
          <ul class="stack-list" aria-label="Tools">
            {site.stack.map(tool => <li><img class="tool-icon" src={tool.icon} alt="" width="16" height="16" loading="lazy" /><span>{tool.name}</span></li>)}
          </ul>
          <h3 class="cloud-heading">Cloud experience</h3>
          <ul class="stack-list" aria-label="Cloud platforms">
            {site.clouds.map(tool => <li><img class="tool-icon" src={tool.icon} alt="" width="16" height="16" loading="lazy" /><span>{tool.name}</span></li>)}
          </ul>
        </section>
        <section id="career" aria-labelledby="career-title">
          <h2 id="career-title">Experience</h2>
          <ol class="career-list">{site.career.map(job => <li>
            <a class="career-row" href={job.url} target="_blank" rel="noopener noreferrer">
              <img class="company-mark" src={job.logo} alt="" width="32" height="32" loading="lazy" />
              <div class="role">
                <div class="company-heading"><h3>{job.company}</h3><span class="tenure">{job.tenure}</span></div>
                <p class="role-title">{job.role}</p>
                <p class="role-description">{job.description}</p>
              </div>
              <span class="external-arrow" aria-hidden="true">↗</span>
              <span class="sr-only">Opens in a new tab</span>
            </a>
          </li>)}</ol>
        </section>
        {projects.length > 0 && <section id="projects" aria-labelledby="projects-title">
          <h2 id="projects-title">Projects</h2>
          <div class="projects">{projects.map(project => <article><h3><a href={project.url}>{project.title} <span aria-hidden="true">↗</span></a></h3><p>{project.description}</p><p>{project.contribution}</p></article>)}</div>
        </section>}
        <section id="contact" aria-labelledby="contact-title">
          <h2 id="contact-title">Find me on</h2>
          <div class="links">{site.links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="sr-only">Opens in a new tab</span></a>)}</div>
        </section>
      </main>
      <footer><span>{site.name}</span><a href="#about">Back to top ↑</a></footer>
    </div>
  </body>
</html>
